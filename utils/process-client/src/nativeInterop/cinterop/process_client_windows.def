package = io.github.stream29.kodex.utils.processclient.winspawn

headers = windows.h
linkerOpts = -ladvapi32 -lbcrypt

---

#include <windows.h>
#include "kodex_windows_pipe.h"

static inline DWORD kodex_create_process_pipe(HANDLE *parent, HANDLE *child, BOOL parent_reads) {
    return kodex_windows_private_pipe(parent, child, parent_reads, TRUE);
}

static inline DWORD kodex_create_process_job(HANDLE process, HANDLE *job) {
    return kodex_windows_create_process_job(process, job);
}

static inline DWORD kodex_terminate_process_tree(HANDLE process, HANDLE job) {
    return kodex_windows_terminate_tree(process, job);
}

typedef struct kodex_pipe_operation {
    OVERLAPPED overlapped;
    void *context;
} kodex_pipe_operation;

static inline HANDLE kodex_create_pipe_port(void) {
    return CreateIoCompletionPort(INVALID_HANDLE_VALUE, NULL, 0, 1);
}

static inline DWORD kodex_associate_pipe(HANDLE port, HANDLE pipe) {
    return CreateIoCompletionPort(pipe, port, 0, 0) == NULL ? GetLastError() : ERROR_SUCCESS;
}

static inline DWORD kodex_submit_pipe_io(
    HANDLE pipe, kodex_pipe_operation *operation, void *context, void *buffer, DWORD count, BOOL reading
) {
    ZeroMemory(operation, sizeof(*operation));
    operation->context = context;
    BOOL ok = reading
        ? ReadFile(pipe, buffer, count, NULL, &operation->overlapped)
        : WriteFile(pipe, buffer, count, NULL, &operation->overlapped);
    if (ok) return ERROR_SUCCESS; /* Even synchronous success queues a packet. */
    DWORD error = GetLastError();
    return error == ERROR_IO_PENDING ? ERROR_SUCCESS : error;
}

static inline void kodex_cancel_pipe_io(HANDLE pipe, kodex_pipe_operation *operation) {
    /* ERROR_NOT_FOUND can race a dequeued packet. Neither result frees memory. */
    CancelIoEx(pipe, &operation->overlapped);
}

static inline DWORD kodex_take_pipe_completion(HANDLE port, void **context, DWORD *count) {
    OVERLAPPED *overlapped = NULL;
    ULONG_PTR key;
    *count = 0;
    BOOL ok = GetQueuedCompletionStatus(port, count, &key, &overlapped, INFINITE);
    DWORD error = ok ? ERROR_SUCCESS : GetLastError();
    *context = overlapped == NULL ? NULL : CONTAINING_RECORD(overlapped, kodex_pipe_operation, overlapped)->context;
    return error;
}

static inline DWORD kodex_register_process_wait(HANDLE *wait, HANDLE process, WAITORTIMERCALLBACK callback, void *context) {
    return RegisterWaitForSingleObject(wait, process, callback, context, INFINITE, WT_EXECUTEONLYONCE)
        ? ERROR_SUCCESS : GetLastError();
}

static inline DWORD kodex_drain_process_wait(HANDLE wait) {
    return UnregisterWaitEx(wait, INVALID_HANDLE_VALUE) ? ERROR_SUCCESS : GetLastError();
}

/* Short critical section for the terminate-versus-close linearization point. */
static SRWLOCK kodex_process_watch_lock = SRWLOCK_INIT;

static inline void kodex_lock_process_watch(void) {
    AcquireSRWLockExclusive(&kodex_process_watch_lock);
}

static inline void kodex_unlock_process_watch(void) {
    ReleaseSRWLockExclusive(&kodex_process_watch_lock);
}

static inline int kodex_spawn_windows_process(
    HANDLE *process_out,
    HANDLE *thread_out,
    wchar_t *command_line,
    const wchar_t *working_directory,
    wchar_t *environment,
    HANDLE stdin_read,
    HANDLE stdout_write,
    HANDLE stderr_write
) {
    SIZE_T attribute_size = 0;
    LPPROC_THREAD_ATTRIBUTE_LIST attributes = NULL;
    STARTUPINFOEXW startup;
    PROCESS_INFORMATION process;
    HANDLE inherited[3] = { stdin_read, stdout_write, stderr_write };
    DWORD error = ERROR_GEN_FAILURE;
    BOOL initialized = FALSE;

    if (process_out == NULL || thread_out == NULL || command_line == NULL ||
        stdin_read == NULL || stdout_write == NULL || stderr_write == NULL) {
        return ERROR_INVALID_PARAMETER;
    }
    *process_out = NULL;
    *thread_out = NULL;
    InitializeProcThreadAttributeList(NULL, 1, 0, &attribute_size);
    if (attribute_size == 0) {
        error = GetLastError();
        return (int)(error == ERROR_SUCCESS ? ERROR_GEN_FAILURE : error);
    }
    attributes = (LPPROC_THREAD_ATTRIBUTE_LIST)HeapAlloc(GetProcessHeap(), 0, attribute_size);
    if (attributes == NULL) return ERROR_NOT_ENOUGH_MEMORY;
    if (!InitializeProcThreadAttributeList(attributes, 1, 0, &attribute_size)) {
        error = GetLastError();
        goto finish;
    }
    initialized = TRUE;
    if (!UpdateProcThreadAttribute(attributes, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
        inherited, sizeof(inherited), NULL, NULL)) {
        error = GetLastError();
        goto finish;
    }
    ZeroMemory(&startup, sizeof(startup));
    startup.StartupInfo.cb = sizeof(startup);
    startup.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
    startup.StartupInfo.hStdInput = stdin_read;
    startup.StartupInfo.hStdOutput = stdout_write;
    startup.StartupInfo.hStdError = stderr_write;
    startup.lpAttributeList = attributes;
    ZeroMemory(&process, sizeof(process));
    if (!CreateProcessW(NULL, command_line, NULL, NULL, TRUE,
        CREATE_NO_WINDOW | CREATE_SUSPENDED | CREATE_UNICODE_ENVIRONMENT | EXTENDED_STARTUPINFO_PRESENT,
        environment, working_directory, &startup.StartupInfo, &process)) {
        error = GetLastError();
        goto finish;
    }
    *process_out = process.hProcess;
    *thread_out = process.hThread;
    error = ERROR_SUCCESS;
finish:
    if (initialized) DeleteProcThreadAttributeList(attributes);
    HeapFree(GetProcessHeap(), 0, attributes);
    if (error == ERROR_SUCCESS && (*process_out == NULL || *thread_out == NULL)) return ERROR_GEN_FAILURE;
    return (int)error;
}
