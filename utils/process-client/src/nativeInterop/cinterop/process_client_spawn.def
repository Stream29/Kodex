package = io.github.stream29.kodex.utils.processclient.cinterop

headers = signal.h unistd.h

---

#ifdef __APPLE__
#include <crt_externs.h>
#define KODEX_ENVIRON (*_NSGetEnviron())
#else
extern char **environ;
#define KODEX_ENVIRON environ
#endif

#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <pthread.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#include <sys/wait.h>
#ifdef __linux__
#include <sys/syscall.h>
// The Kotlin/Native sysroot can predate Linux 5.3; both supported Linux ABIs
// use this syscall number. Old kernels still return ENOSYS.
#if !defined(SYS_pidfd_open) && (defined(__x86_64__) || defined(__aarch64__))
#define SYS_pidfd_open 434
#endif
#endif
#ifdef __APPLE__
#include <sys/event.h>
#endif
#include "kodex_close_inherited_fds.h"

static inline int kodex_process_create_pipe(int descriptors[2]) {
#ifdef __linux__
    return pipe2(descriptors, O_CLOEXEC);
#else
    if (pipe(descriptors) != 0) return -1;
    for (int index = 0; index < 2; index++) {
        int flags = fcntl(descriptors[index], F_GETFD);
        if (flags == -1 || fcntl(descriptors[index], F_SETFD, flags | FD_CLOEXEC) == -1) {
            int failure = errno;
            close(descriptors[0]);
            close(descriptors[1]);
            errno = failure;
            return -1;
        }
    }
    return 0;
#endif
}

static inline int kodex_process_configure_stream(int fd) {
    int flags;
    int result;
    do { flags = fcntl(fd, F_GETFD); } while (flags < 0 && errno == EINTR);
    if (flags < 0) return -1;
    do { result = fcntl(fd, F_SETFD, flags | FD_CLOEXEC); } while (result < 0 && errno == EINTR);
    if (result < 0) return -1;
    do { flags = fcntl(fd, F_GETFL); } while (flags < 0 && errno == EINTR);
    if (flags < 0) return -1;
    do { result = fcntl(fd, F_SETFL, flags | O_NONBLOCK); } while (result < 0 && errno == EINTR);
    return result;
}

static inline int kodex_process_create_wake_pipe(int descriptors[2]) {
#ifdef __linux__
    return pipe2(descriptors, O_CLOEXEC | O_NONBLOCK);
#else
    if (kodex_process_create_pipe(descriptors) < 0) return -1;
    if (
        kodex_process_configure_stream(descriptors[0]) == 0 &&
        kodex_process_configure_stream(descriptors[1]) == 0
    ) return 0;
    int failure = errno;
    close(descriptors[0]);
    close(descriptors[1]);
    errno = failure;
    return -1;
#endif
}

static inline void kodex_process_wake(int fd) {
    char byte = 0;
    // EAGAIN means an earlier notification is still in the pipe.
    while (write(fd, &byte, 1) < 0 && errno == EINTR) { }
}

static inline void kodex_process_drain_wake(int fd) {
    char bytes[4096];
    while (read(fd, bytes, sizeof(bytes)) < 0 && errno == EINTR) { }
}

#define KODEX_POLL_READ 1
#define KODEX_POLL_WRITE 2
#define KODEX_POLL_ERROR 4
#define KODEX_POLL_INVALID 8
#define KODEX_POLL_HANGUP 16

// Each row is {fd, interests, ready}. Keep nfds_t and struct pollfd inside C;
// their ABI is not part of the commonized Native binding.
static inline int kodex_process_poll(int *rows, int count, int timeout) {
    struct pollfd local[64];
    struct pollfd *fds = count <= 64 ? local : malloc((size_t)count * sizeof(*fds));
    if (fds == NULL) {
        errno = ENOMEM;
        return -1;
    }
    for (int index = 0; index < count; index++) {
        int interests = rows[index * 3 + 1];
        fds[index].fd = rows[index * 3];
        fds[index].events = (interests & KODEX_POLL_READ ? POLLIN : 0) |
            (interests & KODEX_POLL_WRITE ? POLLOUT : 0);
        fds[index].revents = 0;
    }
    int ready = poll(fds, (nfds_t)count, timeout);
    int error = ready < 0 ? errno : 0;
    if (ready > 0) {
        for (int index = 0; index < count; index++) {
            short events = fds[index].revents;
            rows[index * 3 + 2] = (events & POLLIN ? KODEX_POLL_READ : 0) |
                (events & POLLOUT ? KODEX_POLL_WRITE : 0) |
                (events & POLLERR ? KODEX_POLL_ERROR : 0) |
                (events & POLLNVAL ? KODEX_POLL_INVALID : 0) |
                (events & POLLHUP ? KODEX_POLL_HANGUP : 0);
        }
    }
    if (fds != local) free(fds);
    if (ready < 0) errno = error;
    return ready;
}

static inline int kodex_process_pty_eio_is_eof(void) {
#ifdef __linux__
    return 1;
#else
    return 0;
#endif
}

static inline int kodex_process_open_pidfd(pid_t pid) {
#if defined(__linux__) && defined(SYS_pidfd_open)
    int result;
    do { result = (int)syscall(SYS_pidfd_open, pid, 0); } while (result < 0 && errno == EINTR);
    return result;
#else
    return -1;
#endif
}

static inline int kodex_process_open_exit_queue(void) {
#ifdef __APPLE__
    int fd = kqueue();
    if (fd < 0) return -1;
    if (fcntl(fd, F_SETFD, FD_CLOEXEC) == 0) return fd;
    close(fd);
#endif
    return -1;
}

static inline int kodex_process_watch_kqueue(int fd, pid_t pid, long long token) {
#ifdef __APPLE__
    struct kevent change;
    EV_SET(&change, pid, EVFILT_PROC, EV_ADD | EV_ONESHOT, NOTE_EXIT, 0, (void *)(intptr_t)token);
    // Do not retry EV_ADD on EINTR: the change may already have taken effect.
    return kevent(fd, &change, 1, NULL, 0, NULL);
#else
    return -1;
#endif
}

static inline void kodex_process_unwatch_kqueue(int fd, pid_t pid) {
#ifdef __APPLE__
    struct kevent change;
    EV_SET(&change, pid, EVFILT_PROC, EV_DELETE, 0, 0, NULL);
    while (kevent(fd, &change, 1, NULL, 0, NULL) < 0 && errno == EINTR) { }
#endif
}

static inline long long kodex_process_next_exit_event(int fd) {
#ifdef __APPLE__
    struct kevent event;
    struct timespec no_wait = {0, 0};
    int count;
    do { count = kevent(fd, NULL, 0, &event, 1, &no_wait); } while (count < 0 && errno == EINTR);
    if (count > 0) return (intptr_t)event.udata;
    if (count < 0) return -1;
#endif
    return 0;
}

static inline int kodex_process_reap(pid_t pid, int *exit_code) {
    int status;
    pid_t result;
    do { result = waitpid(pid, &status, WNOHANG); } while (result < 0 && errno == EINTR);
    if (result <= 0) return result;
    if (WIFEXITED(status)) *exit_code = WEXITSTATUS(status);
    else if (WIFSIGNALED(status)) *exit_code = 128 + WTERMSIG(status);
    else return 0;
    return 1;
}

static inline size_t kodex_process_environment_name_length(const char *entry) {
    const char *separator = strchr(entry, '=');
    return separator == NULL ? strlen(entry) : (size_t)(separator - entry);
}

static inline int kodex_process_environment_names_equal(const char *first, const char *second) {
    size_t first_length = kodex_process_environment_name_length(first);
    size_t second_length = kodex_process_environment_name_length(second);
    return first_length == second_length && strncmp(first, second, first_length) == 0;
}

static inline char **kodex_process_merge_environment(
    const char *const *overrides,
    size_t override_count
) {
    size_t inherited_count = 0;
    size_t output_count = 0;
    size_t inherited_index;
    size_t override_index;
    char **merged;

    while (KODEX_ENVIRON[inherited_count] != NULL) inherited_count++;
    merged = (char **)malloc((inherited_count + override_count + 1) * sizeof(char *));
    if (merged == NULL) return NULL;

    for (inherited_index = 0; inherited_index < inherited_count; inherited_index++) {
        int overridden = 0;
        for (override_index = 0; override_index < override_count; override_index++) {
            if (kodex_process_environment_names_equal(
                KODEX_ENVIRON[inherited_index],
                overrides[override_index]
            )) {
                overridden = 1;
                break;
            }
        }
        if (!overridden) merged[output_count++] = KODEX_ENVIRON[inherited_index];
    }
    for (override_index = 0; override_index < override_count; override_index++) {
        merged[output_count++] = (char *)overrides[override_index];
    }
    merged[output_count] = NULL;
    return merged;
}

static inline const char *kodex_process_environment_value(
    char *const *environment,
    const char *name
) {
    size_t name_length = strlen(name);
    size_t index = 0;
    while (environment[index] != NULL) {
        if (
            strncmp(environment[index], name, name_length) == 0 &&
            environment[index][name_length] == '='
        ) {
            return environment[index] + name_length + 1;
        }
        index++;
    }
    return NULL;
}

static inline char *kodex_process_join_path(
    const char *first,
    size_t first_length,
    const char *second,
    size_t second_length,
    const char *file
) {
    size_t file_length = strlen(file);
    size_t length = first_length + second_length + file_length + 3;
    char *path = (char *)malloc(length);
    size_t offset = 0;
    if (path == NULL) return NULL;

    if (first_length > 0) {
        memcpy(path + offset, first, first_length);
        offset += first_length;
        if (path[offset - 1] != '/') path[offset++] = '/';
    }
    if (second_length > 0) {
        memcpy(path + offset, second, second_length);
        offset += second_length;
        if (path[offset - 1] != '/') path[offset++] = '/';
    }
    memcpy(path + offset, file, file_length);
    path[offset + file_length] = '\0';
    return path;
}

static inline char *kodex_process_resolve_executable(
    const char *executable,
    const char *working_directory,
    char *const *environment
) {
    if (strchr(executable, '/') != NULL) {
        char *candidate = executable[0] == '/'
            ? strdup(executable)
            : kodex_process_join_path(
                working_directory,
                strlen(working_directory),
                "",
                0,
                executable
            );
        char *resolved;
        if (candidate == NULL) return NULL;
        resolved = realpath(candidate, NULL);
        free(candidate);
        return resolved;
    }

    {
        const char *path = kodex_process_environment_value(environment, "PATH");
        const char *cursor = path == NULL ? "/bin:/usr/bin" : path;
        while (1) {
            const char *separator = strchr(cursor, ':');
            size_t directory_length = separator == NULL
                ? strlen(cursor)
                : (size_t)(separator - cursor);
            int absolute_directory = directory_length > 0 && cursor[0] == '/';
            char *candidate = kodex_process_join_path(
                absolute_directory ? "" : working_directory,
                absolute_directory ? 0 : strlen(working_directory),
                cursor,
                directory_length,
                executable
            );
            if (candidate == NULL) return NULL;
            if (access(candidate, X_OK) == 0) {
                char *resolved = realpath(candidate, NULL);
                free(candidate);
                if (resolved != NULL) return resolved;
            } else {
                free(candidate);
            }
            if (separator == NULL) break;
            cursor = separator + 1;
        }
    }
    return NULL;
}

static inline int kodex_spawn_process(
    pid_t *pid,
    int *process_group,
    int stdin_read,
    int stdin_write,
    int output_read,
    int output_write,
    int error_read,
    int error_write,
    const char *executable,
    const char *const *arguments,
    size_t argument_count,
    const char *const *environment_overrides,
    size_t environment_override_count,
    const char *working_directory
) {
    char **argv = NULL;
    char **merged_environment = NULL;
    char *const *child_environment = KODEX_ENVIRON;
    char *resolved_executable = NULL;
    pid_t child;
    int result = 0;
    size_t argument_index;

#ifdef __APPLE__
    if (fcntl(stdin_write, F_SETNOSIGPIPE, 1) != 0) {
        return errno;
    }
#endif

    if (environment_override_count > 0) {
        merged_environment = kodex_process_merge_environment(
            environment_overrides,
            environment_override_count
        );
        if (merged_environment == NULL) {
            result = ENOMEM;
        } else {
            child_environment = merged_environment;
        }
    }

    if (result == 0) {
        argv = (char **)malloc((argument_count + 2) * sizeof(char *));
        if (argv == NULL) {
            result = ENOMEM;
        } else {
            argv[0] = (char *)executable;
            for (argument_index = 0; argument_index < argument_count; argument_index++) {
                argv[argument_index + 1] = (char *)arguments[argument_index];
            }
            argv[argument_count + 1] = NULL;
            resolved_executable = kodex_process_resolve_executable(
                executable,
                working_directory,
                child_environment
            );
        }
    }

    if (result == 0) {
        child = fork();
        if (child < 0) {
            result = errno;
        } else if (child == 0) {
            if (
                setpgid(0, 0) != 0 ||
                dup2(stdin_read, STDIN_FILENO) < 0 ||
                dup2(output_write, STDOUT_FILENO) < 0 ||
                dup2(error_write, STDERR_FILENO) < 0
            ) {
                _exit(127);
            }
            if (stdin_read > STDERR_FILENO) close(stdin_read);
            if (stdin_write > STDERR_FILENO) close(stdin_write);
            if (output_read > STDERR_FILENO) close(output_read);
            if (output_write > STDERR_FILENO) close(output_write);
            if (error_read > STDERR_FILENO) close(error_read);
            if (error_write > STDERR_FILENO) close(error_write);
#if defined(__linux__) || defined(__APPLE__)
            if (kodex_close_inherited_fds() != 0) _exit(127);
#endif
            if (chdir(working_directory) != 0 || resolved_executable == NULL) {
                _exit(127);
            }
            execve(resolved_executable, argv, child_environment);
            _exit(127);
        } else {
            int group_result = setpgid(child, child);
            *pid = child;
            *process_group = group_result == 0 || errno == EACCES;
        }
    }

    free(resolved_executable);
    free(argv);
    free(merged_environment);
    return result;
}

static inline ssize_t kodex_process_write(
    int descriptor,
    const void *bytes,
    size_t byte_count
) {
    sigset_t blocked_signals;
    sigset_t previous_signals;
    sigset_t pending_signals;
    int had_pending_sigpipe = 0;
    int write_errno;
    ssize_t result;

    sigemptyset(&blocked_signals);
    sigaddset(&blocked_signals, SIGPIPE);
    if (pthread_sigmask(SIG_BLOCK, &blocked_signals, &previous_signals) != 0) {
        return write(descriptor, bytes, byte_count);
    }
    if (sigpending(&pending_signals) == 0) {
        had_pending_sigpipe = sigismember(&pending_signals, SIGPIPE) == 1;
    }

    result = write(descriptor, bytes, byte_count);
    write_errno = errno;
    if (result < 0 && write_errno == EPIPE && !had_pending_sigpipe) {
        int signal_number;
        if (
            sigpending(&pending_signals) == 0 &&
            sigismember(&pending_signals, SIGPIPE) == 1
        ) {
            sigwait(&blocked_signals, &signal_number);
        }
    }
    pthread_sigmask(SIG_SETMASK, &previous_signals, NULL);
    errno = write_errno;
    return result;
}
