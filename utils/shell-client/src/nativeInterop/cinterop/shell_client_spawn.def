package = io.github.stream29.codex.lite.utils.shellclient.cinterop

headers = spawn.h unistd.h

---

#ifdef __APPLE__
#include <crt_externs.h>
#include <util.h>
#define CODEXLITE_ENVIRON (*_NSGetEnviron())
#else
#include <pty.h>
extern char **environ;
#define CODEXLITE_ENVIRON environ
#endif

#include <errno.h>
#include <stdlib.h>
#include <string.h>

static inline size_t codexlite_environment_name_length(const char *entry) {
    const char *separator = strchr(entry, '=');
    return separator == NULL ? strlen(entry) : (size_t)(separator - entry);
}

static inline int codexlite_environment_names_equal(const char *first, const char *second) {
    size_t first_length = codexlite_environment_name_length(first);
    size_t second_length = codexlite_environment_name_length(second);
    return first_length == second_length && strncmp(first, second, first_length) == 0;
}

static inline char **codexlite_merge_environment(
    const char *const *overrides,
    size_t override_count
) {
    size_t inherited_count = 0;
    size_t output_count = 0;
    size_t inherited_index;
    size_t override_index;
    char **merged;

    while (CODEXLITE_ENVIRON[inherited_count] != NULL) inherited_count++;
    merged = (char **)malloc((inherited_count + override_count + 1) * sizeof(char *));
    if (merged == NULL) return NULL;

    for (inherited_index = 0; inherited_index < inherited_count; inherited_index++) {
        int overridden = 0;
        for (override_index = 0; override_index < override_count; override_index++) {
            if (codexlite_environment_names_equal(
                CODEXLITE_ENVIRON[inherited_index],
                overrides[override_index]
            )) {
                overridden = 1;
                break;
            }
        }
        if (!overridden) merged[output_count++] = CODEXLITE_ENVIRON[inherited_index];
    }
    for (override_index = 0; override_index < override_count; override_index++) {
        merged[output_count++] = (char *)overrides[override_index];
    }
    merged[output_count] = NULL;
    return merged;
}

static inline int codexlite_spawn_pty_shell(
    pid_t *pid,
    int *master_fd,
    const char *const *environment_overrides,
    size_t environment_override_count,
    const char *shell,
    const char *first_argument,
    const char *second_argument,
    const char *command
) {
    char **merged_environment = NULL;
    if (environment_override_count > 0) {
        merged_environment = codexlite_merge_environment(
            environment_overrides,
            environment_override_count
        );
        if (merged_environment == NULL) return ENOMEM;
    }

    pid_t child = forkpty(master_fd, NULL, NULL, NULL);
    if (child < 0) {
        int fork_error = errno;
        free(merged_environment);
        return fork_error;
    }

    if (child == 0) {
        char *argv[5];
        int argument_count = 0;
        argv[0] = (char *)shell;
        if (first_argument != NULL) argv[++argument_count] = (char *)first_argument;
        if (second_argument != NULL) argv[++argument_count] = (char *)second_argument;
        argv[++argument_count] = (char *)command;
        argv[++argument_count] = NULL;
        if (merged_environment != NULL) CODEXLITE_ENVIRON = merged_environment;
        execvp(shell, argv);
        _exit(127);
    }

    free(merged_environment);
    *pid = child;
    return 0;
}
