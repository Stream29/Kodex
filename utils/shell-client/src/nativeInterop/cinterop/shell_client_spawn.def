package = io.github.stream29.codex.lite.utils.shellclient.cinterop

headers = spawn.h unistd.h

---

#ifdef __APPLE__
#include <crt_externs.h>
#include <util.h>
#define CODEXLITE_ENVIRON (*_NSGetEnviron())
#else
#include <pty.h>
extern char **environ;
#define CODEXLITE_ENVIRON environ
#endif

#include <errno.h>
#include <stdlib.h>
#include <string.h>

static inline size_t codexlite_environment_name_length(const char *entry) {
    const char *separator = strchr(entry, '=');
    return separator == NULL ? strlen(entry) : (size_t)(separator - entry);
}

static inline int codexlite_environment_names_equal(const char *first, const char *second) {
    size_t first_length = codexlite_environment_name_length(first);
    size_t second_length = codexlite_environment_name_length(second);
    return first_length == second_length && strncmp(first, second, first_length) == 0;
}

static inline char **codexlite_merge_environment(
    const char *const *overrides,
    size_t override_count
) {
    size_t inherited_count = 0;
    size_t output_count = 0;
    size_t inherited_index;
    size_t override_index;
    char **merged;

    while (CODEXLITE_ENVIRON[inherited_count] != NULL) inherited_count++;
    merged = (char **)malloc((inherited_count + override_count + 1) * sizeof(char *));
    if (merged == NULL) return NULL;

    for (inherited_index = 0; inherited_index < inherited_count; inherited_index++) {
        int overridden = 0;
        for (override_index = 0; override_index < override_count; override_index++) {
            if (codexlite_environment_names_equal(
                CODEXLITE_ENVIRON[inherited_index],
                overrides[override_index]
            )) {
                overridden = 1;
                break;
            }
        }
        if (!overridden) merged[output_count++] = CODEXLITE_ENVIRON[inherited_index];
    }
    for (override_index = 0; override_index < override_count; override_index++) {
        merged[output_count++] = (char *)overrides[override_index];
    }
    merged[output_count] = NULL;
    return merged;
}

static inline int codexlite_spawn_shell(
    pid_t *pid,
    int *process_group,
    int stdin_read,
    int stdin_write,
    int output_read,
    int output_write,
    int error_read,
    int error_write,
    const char *const *environment_overrides,
    size_t environment_override_count,
    const char *shell,
    const char *first_argument,
    const char *second_argument,
    const char *command
) {
    char **merged_environment = NULL;
    char *const *child_environment = CODEXLITE_ENVIRON;
    posix_spawn_file_actions_t actions;
    int result = posix_spawn_file_actions_init(&actions);
    if (result != 0) return result;

    posix_spawnattr_t attributes;
    result = posix_spawnattr_init(&attributes);
    if (result != 0) {
        posix_spawn_file_actions_destroy(&actions);
        return result;
    }

    short attributes_flags = 0;
    int owns_process_group = 0;
#ifdef POSIX_SPAWN_SETPGROUP
    result = posix_spawnattr_setpgroup(&attributes, 0);
    if (result == 0) {
        attributes_flags |= POSIX_SPAWN_SETPGROUP;
        owns_process_group = 1;
    }
#endif
    if (result == 0) result = posix_spawnattr_setflags(&attributes, attributes_flags);

    if (result == 0) result = posix_spawn_file_actions_adddup2(&actions, stdin_read, STDIN_FILENO);
    if (result == 0) result = posix_spawn_file_actions_adddup2(&actions, output_write, STDOUT_FILENO);
    if (result == 0) result = posix_spawn_file_actions_adddup2(&actions, error_write, STDERR_FILENO);
    if (result == 0) result = posix_spawn_file_actions_addclose(&actions, stdin_read);
    if (result == 0) result = posix_spawn_file_actions_addclose(&actions, stdin_write);
    if (result == 0) result = posix_spawn_file_actions_addclose(&actions, output_read);
    if (result == 0) result = posix_spawn_file_actions_addclose(&actions, output_write);
    if (result == 0) result = posix_spawn_file_actions_addclose(&actions, error_read);
    if (result == 0) result = posix_spawn_file_actions_addclose(&actions, error_write);

    if (result == 0 && environment_override_count > 0) {
        merged_environment = codexlite_merge_environment(
            environment_overrides,
            environment_override_count
        );
        if (merged_environment == NULL) {
            result = ENOMEM;
        } else {
            child_environment = merged_environment;
        }
    }

    if (result == 0) {
        char *argv[5];
        int argument_count = 0;
        argv[0] = (char *)shell;
        if (first_argument != NULL) argv[++argument_count] = (char *)first_argument;
        if (second_argument != NULL) argv[++argument_count] = (char *)second_argument;
        argv[++argument_count] = (char *)command;
        argv[++argument_count] = NULL;
        result = posix_spawnp(pid, shell, &actions, &attributes, argv, child_environment);
        if (result == 0) *process_group = owns_process_group;
    }
    free(merged_environment);

    int attributes_destroy_result = posix_spawnattr_destroy(&attributes);
    int destroy_result = posix_spawn_file_actions_destroy(&actions);
    if (result != 0) return result;
    if (attributes_destroy_result != 0) return attributes_destroy_result;
    return destroy_result;
}

static inline int codexlite_spawn_pty_shell(
    pid_t *pid,
    int *master_fd,
    const char *const *environment_overrides,
    size_t environment_override_count,
    const char *shell,
    const char *first_argument,
    const char *second_argument,
    const char *command
) {
    char **merged_environment = NULL;
    if (environment_override_count > 0) {
        merged_environment = codexlite_merge_environment(
            environment_overrides,
            environment_override_count
        );
        if (merged_environment == NULL) return ENOMEM;
    }

    pid_t child = forkpty(master_fd, NULL, NULL, NULL);
    if (child < 0) {
        int fork_error = errno;
        free(merged_environment);
        return fork_error;
    }

    if (child == 0) {
        char *argv[5];
        int argument_count = 0;
        argv[0] = (char *)shell;
        if (first_argument != NULL) argv[++argument_count] = (char *)first_argument;
        if (second_argument != NULL) argv[++argument_count] = (char *)second_argument;
        argv[++argument_count] = (char *)command;
        argv[++argument_count] = NULL;
        if (merged_environment != NULL) CODEXLITE_ENVIRON = merged_environment;
        execvp(shell, argv);
        _exit(127);
    }

    free(merged_environment);
    *pid = child;
    return 0;
}
